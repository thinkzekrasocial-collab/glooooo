# Copy to .env on the Jitsi host. Generate all internal passwords with
# the official docker-jitsi-meet ./gen-passwords.sh helper.
JITSI_IMAGE_VERSION=stable-11146
CONFIG=/opt/jitsi-meet-cfg
PUBLIC_URL=https://meet.example.com
TZ=UTC
HTTP_PORT=80
HTTPS_PORT=443
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID=replace_with_the_same_JITSI_APP_ID
JWT_APP_SECRET=replace_with_the_same_JITSI_APP_SECRET
JWT_ACCEPTED_ISSUERS=replace_with_JITSI_JWT_ISSUER
JWT_ACCEPTED_AUDIENCES=replace_with_JITSI_JWT_AUDIENCE
JWT_ALLOW_EMPTY=0

# Required by the official stack; replace every value with a unique secret.
XMPP_DOMAIN=meet.example.com
XMPP_AUTH_DOMAIN=auth.meet.example.com
XMPP_MUC_DOMAIN=muc.meet.example.com
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.example.com
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=replace_me
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=replace_me
JICOFO_COMPONENT_SECRET=replace_me
XMPP_RECORDER_DOMAIN=recorder.meet.example.com
XMPP_RECORDER_USER=recorder
XMPP_RECORDER_PASSWORD=replace_me

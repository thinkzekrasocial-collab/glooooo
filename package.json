{
  "name": "nextjs-postgresql-template",
  "private": true,
  "engines": { "node": ">=20.9.0 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "dev:cloudflare": "wrangler dev --config cloudflare/wrangler.jsonc",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.10",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  },
  "type": "module"
}

# Next/GlobeBridge server configuration
DATABASE_URL=postgresql://user:password@localhost:5432/globebridge
NEXT_PUBLIC_API_BASE_URL=

# Server-only Jitsi JWT configuration. Never expose APP_SECRET to the browser.
JITSI_BASE_URL=https://meet.example.com
JITSI_APP_ID=replace_with_a_unique_application_id
JITSI_APP_SECRET=replace_with_a_long_random_secret
JITSI_JWT_ISSUER=replace_with_issuer
JITSI_JWT_AUDIENCE=replace_with_audience
JITSI_JWT_SUBJECT=meet.example.com
